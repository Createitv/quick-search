<Application x:Class="QuickSearch.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <sys:Double x:Key="AppFontSize">14</sys:Double>
      <sys:Double x:Key="AppFontSizeSmall">12</sys:Double>
      <sys:Double x:Key="AppFontSizeSecondary">13</sys:Double>
      <sys:Double x:Key="AppFontSizeSection">16</sys:Double>
      <sys:Double x:Key="AppFontSizeTitle">28</sys:Double>
      <sys:Double x:Key="AppFontSizeDialogTitle">22</sys:Double>
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Light" />
        <ui:ControlsDictionary />
        <ResourceDictionary Source="Themes/ModernTheme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
