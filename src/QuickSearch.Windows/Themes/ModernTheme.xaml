<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Path Beam palette -->
  <Color x:Key="FogColor">#F3F6FB</Color>
  <Color x:Key="PaperColor">#FFFFFF</Color>
  <Color x:Key="InkColor">#162033</Color>
  <Color x:Key="SlateColor">#667085</Color>
  <Color x:Key="RouteBlueColor">#2F6BFF</Color>
  <Color x:Key="SignalCyanColor">#36C5E5</Color>
  <Color x:Key="ErrorColor">#D92D20</Color>
  <Color x:Key="LineColor">#DCE3EE</Color>
  <Color x:Key="SoftBlueColor">#EDF3FF</Color>
  <Color x:Key="SoftCyanColor">#EAFBFE</Color>
  <Color x:Key="SoftErrorColor">#FFF1F0</Color>
  <Color x:Key="MutedSurfaceColor">#F8FAFD</Color>

  <SolidColorBrush x:Key="FogBrush" Color="{StaticResource FogColor}" />
  <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
  <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}" />
  <SolidColorBrush x:Key="RouteBlueBrush" Color="{StaticResource RouteBlueColor}" />
  <SolidColorBrush x:Key="SignalCyanBrush" Color="{StaticResource SignalCyanColor}" />
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="SoftBlueBrush" Color="{StaticResource SoftBlueColor}" />
  <SolidColorBrush x:Key="SoftCyanBrush" Color="{StaticResource SoftCyanColor}" />
  <SolidColorBrush x:Key="SoftErrorBrush" Color="{StaticResource SoftErrorColor}" />
  <SolidColorBrush x:Key="MutedSurfaceBrush" Color="{StaticResource MutedSurfaceColor}" />
  <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />

  <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>

  <Style x:Key="KeyboardFocusStyle" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource RouteBlueBrush}"
                  BorderThickness="2"
                  CornerRadius="11"
                  Margin="-3" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Window">
    <Setter Property="Background" Value="{DynamicResource FogBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
  </Style>

  <Style x:Key="WindowTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>

  <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style x:Key="SurfaceCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
  </Style>

  <Style x:Key="PillStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SoftCyanBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style TargetType="TextBox">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource RouteBlueBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="InputBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource RouteBlueBrush}" />
              <Setter TargetName="InputBorder" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="InputBorder" Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
              <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ButtonBaseStyle" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBorder"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="10"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource RouteBlueBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}" />

  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="{DynamicResource RouteBlueBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{DynamicResource RouteBlueBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#245BE0" />
        <Setter Property="BorderBrush" Value="#245BE0" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource BodyFont}" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
  </Style>

  <Style TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style x:Key="ResultListItemStyle" TargetType="ListBoxItem">
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid>
            <Border x:Name="CardBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="16,12,14,12">
              <ContentPresenter />
            </Border>
            <Border x:Name="SelectionRail"
                    Width="4"
                    Margin="0,7,0,7"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource RouteBlueBrush}"
                    CornerRadius="2"
                    Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SoftBlueBrush}" />
              <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource RouteBlueBrush}" />
              <Setter TargetName="SelectionRail" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource RouteBlueBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PinnedFolderButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
  </Style>

  <Style x:Key="WindowCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="43" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="CaptionSurface" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="CaptionSurface" Property="Opacity" Value="0.72" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowCaptionButtonStyle}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E81123" />
        <Setter Property="Foreground" Value="White" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ExplorerTreeItemStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FontWeight" Value="Normal" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource RouteBlueBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ExplorerTreeViewItemStyle" TargetType="TreeViewItem">
    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
  </Style>

  <Style x:Key="FolderCardButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Height" Value="88" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
  </Style>

  <Style x:Key="RuleRowButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="15,12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource PaperBrush}" />
  </Style>

  <Style x:Key="BreadcrumbButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="5,3" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
  </Style>

  <Style x:Key="BottomGearButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="Foreground" Value="{DynamicResource SlateBrush}" />
  </Style>

  <Style x:Key="ShortcutBadgeStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SoftBlueBrush}" />
    <Setter Property="BorderBrush" Value="#CBD9FA" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Style.Triggers>
      <Trigger Property="Tag" Value="">
        <Setter Property="Visibility" Value="Collapsed" />
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
