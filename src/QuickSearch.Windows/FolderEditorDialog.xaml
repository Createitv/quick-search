<Window x:Class="QuickSearch.Windows.FolderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="文件夹" Icon="Assets/QuickSearch.ico"
        Width="440" SizeToContent="Height" MinHeight="250"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="26,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="42" Height="42" Margin="0,0,13,0" CornerRadius="12"
              Background="{DynamicResource SoftBlueBrush}">
        <ui:SymbolIcon x:Name="FolderIcon" Symbol="FolderAdd24" FontSize="21"
                       Foreground="{DynamicResource RouteBlueBrush}" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="DialogTitle" Style="{StaticResource SectionTitleStyle}" />
        <TextBlock x:Name="DialogDescription" Margin="0,3,0,0"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </StackPanel>

    <TextBlock Grid.Row="1" Margin="0,22,0,7" Text="文件夹名称"
               Style="{StaticResource FieldLabelStyle}" />
    <TextBox x:Name="NameBox" Grid.Row="2" MaxLength="80"
             TextChanged="NameBox_TextChanged" />

    <Grid Grid.Row="3" Margin="0,22,0,0">
      <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}"
                 VerticalAlignment="Center" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button IsCancel="True" Style="{StaticResource QuietButtonStyle}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Dismiss20" FontSize="16" />
            <TextBlock Text="取消" />
          </StackPanel>
        </Button>
        <Button x:Name="ConfirmButton" Margin="8,0,0,0"
                IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"
                Click="ConfirmButton_Click">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Checkmark20" FontSize="16" />
            <TextBlock x:Name="ConfirmButtonText" Text="创建" Foreground="White" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
