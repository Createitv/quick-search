<Window x:Class="QuickSearch.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSearch 设置" Width="640" Height="520"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" Text="设置" FontSize="24" FontWeight="SemiBold" />
    <StackPanel Grid.Row="1" Margin="0,14,0,8">
      <TextBlock Text="全局快捷键（例如 Ctrl+Alt+F）" />
      <TextBox x:Name="ShortcutBox" />
      <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动" Margin="0,8" />
    </StackPanel>
    <DockPanel Grid.Row="2" Margin="0,8">
      <Button DockPanel.Dock="Right" Content="删除所选映射" Click="Delete_Click" />
      <TextBlock Text="已保存映射" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>
    <ListBox Grid.Row="3" x:Name="MappingsList">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4">
            <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding FolderPath}" Foreground="#555" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" IsCancel="True" />
      <Button Content="保存" IsDefault="True" Click="Save_Click" />
    </StackPanel>
  </Grid>
</Window>
