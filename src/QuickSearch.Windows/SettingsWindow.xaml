<Window x:Class="QuickSearch.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickSearch.Core;assembly=QuickSearch.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="设置" Icon="Assets/QuickSearch.ico" Width="920" Height="700"
        MinWidth="760" MinHeight="580" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Closing="Window_Closing">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type core:NavigationFolderNodeViewModel}" ItemsSource="{Binding Children}">
      <Button Style="{StaticResource ExplorerTreeItemStyle}"
              Command="{Binding DataContext.Organizer.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding Folder}">
        <StackPanel Orientation="Horizontal">
          <ui:SymbolIcon Margin="0,0,7,0" Symbol="Folder20" FontSize="17"
                         Foreground="{DynamicResource RouteBlueBrush}" />
          <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelCommand}" /></Window.InputBindings>

  <Grid Background="{DynamicResource PaperBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Border Padding="24,18" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal">
        <Border Width="42" Height="42" Margin="0,0,13,0" CornerRadius="12"
                Background="{DynamicResource SoftBlueBrush}">
          <ui:SymbolIcon Symbol="SettingsCogMultiple24" FontSize="21"
                         Foreground="{DynamicResource RouteBlueBrush}" />
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="设置" Style="{StaticResource WindowTitleStyle}" />
          <TextBlock Margin="0,3,0,0" Text="通用选项、分类层级和快速打开规则" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="20,16,20,0">
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Settings20" FontSize="16" />
            <TextBlock Text="通用" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,18">
            <TextBlock Text="Everything" Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="0,10,0,24" Style="{StaticResource SurfaceCardStyle}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,9,0" Symbol="Database20" FontSize="18"
                               Foreground="{DynamicResource RouteBlueBrush}" />
                <TextBlock Text="{Binding EverythingHealthText}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <TextBlock Text="全局快捷键" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Width="300" HorizontalAlignment="Left" Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="2,6,0,20" Text="复制关键词后按此快捷键，可直接打开所有匹配规则。" Style="{StaticResource SecondaryTextStyle}" />
            <CheckBox Content="登录 Windows 后自动启动" IsChecked="{Binding StartWithWindows}" />

            <TextBlock Margin="0,28,0,0" Text="快速启动器" Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="0,10,0,0" Style="{StaticResource SurfaceCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Margin="0,0,14,0" CornerRadius="12"
                        Background="{DynamicResource SoftBlueBrush}">
                  <ui:SymbolIcon Symbol="Search24" FontSize="21"
                                 Foreground="{DynamicResource RouteBlueBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="启动器全局快捷键" Style="{StaticResource FieldLabelStyle}" />
                  <TextBox Width="260" HorizontalAlignment="Left"
                           Text="{Binding LauncherShortcut, UpdateSourceTrigger=PropertyChanged}" />
                  <TextBlock Margin="2,6,0,0"
                             Text="随时搜索应用、文件、真实文件夹和已保存快捷方式。"
                             Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Top"
                        Style="{StaticResource QuietButtonStyle}"
                        Command="{Binding OpenQuickLauncherCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Open20" FontSize="16" />
                    <TextBlock Text="立即打开" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <TextBlock Margin="0,28,0,0" Text="应用更新" Style="{StaticResource SectionTitleStyle}" />
            <Border Margin="0,10,0,0" Style="{StaticResource SurfaceCardStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" Margin="0,0,14,0" CornerRadius="12"
                        Background="{DynamicResource SoftBlueBrush}">
                  <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="21"
                                 Foreground="{DynamicResource RouteBlueBrush}" />
                </Border>
                <StackPanel Grid.Column="1">
                  <TextBlock FontWeight="SemiBold">
                    <Run Text="当前版本 " /><Run Text="{Binding Update.InstalledVersion, Mode=OneWay}" />
                    <Run Text=" · 最新版本 " /><Run Text="{Binding Update.LatestVersion, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Margin="0,4,0,0" Text="{Binding Update.StatusText}"
                             Style="{StaticResource SecondaryTextStyle}" />
                  <CheckBox Margin="0,12,0,0" Content="每次启动时自动检查更新"
                            IsChecked="{Binding AutomaticallyCheckForUpdates}" />
                  <ProgressBar Margin="0,12,0,0" Height="4" Minimum="0" Maximum="1"
                               Value="{Binding Update.DownloadProgress, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0" Orientation="Horizontal"
                            VerticalAlignment="Top">
                  <Button Style="{StaticResource QuietButtonStyle}"
                          Command="{Binding Update.CheckNowCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowSync20" FontSize="16" />
                      <TextBlock Text="立即检查" />
                    </StackPanel>
                  </Button>
                  <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                          IsEnabled="{Binding Update.CanDownloadAndInstall}"
                          Click="DownloadAndInstall_Click">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowDownload20" FontSize="16" />
                      <TextBlock Text="下载并安装" Foreground="White" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="AppsListDetail20" FontSize="16" />
            <TextBlock Text="分类与规则" />
          </StackPanel>
        </TabItem.Header>
        <Grid Margin="8,14,8,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="270" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock Text="分类文件夹" Style="{StaticResource SectionTitleStyle}" Margin="4,2,0,10" />
              <TreeView Grid.Row="1" ItemsSource="{Binding Organizer.RootFolders}" BorderThickness="0" Background="Transparent"
                        ItemContainerStyle="{StaticResource ExplorerTreeViewItemStyle}" />
              <Button Grid.Row="2" Margin="0,12,0,0" Padding="10,7"
                      HorizontalContentAlignment="Center"
                      Click="NewFolder_Click">
                <StackPanel Orientation="Horizontal">
                  <ui:SymbolIcon Symbol="FolderAdd20" Margin="0,0,7,0" />
                  <TextBlock Text="新建子文件夹…" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Row="3" Margin="0,9,0,0">
                <Button Padding="10,7" Style="{StaticResource QuietButtonStyle}"
                        Click="RenameFolder_Click">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,7,0" Symbol="Edit20" FontSize="16" />
                    <TextBlock Text="重命名当前文件夹…" />
                  </StackPanel>
                </Button>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ComboBox ItemsSource="{Binding Organizer.Folders}" DisplayMemberPath="Name" SelectedItem="{Binding Organizer.MoveTargetFolder, Mode=TwoWay}" />
                  <Button Grid.Column="1" Margin="7,0,0,0" Padding="10,6"
                          Command="{Binding Organizer.MoveSelectedFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" Symbol="FolderArrowRight20" FontSize="16" />
                      <TextBlock Text="移动到" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Button Margin="0,8,0,0" Padding="10,6" Style="{StaticResource QuietButtonStyle}" Click="DeleteFolder_Click">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,7,0" Symbol="Delete20" FontSize="16"
                                   Foreground="{DynamicResource ErrorBrush}" />
                    <TextBlock Text="删除当前分类…" Foreground="{DynamicResource ErrorBrush}" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="14">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <Grid Margin="0,0,0,10">
                <StackPanel>
                  <TextBlock Text="{Binding Organizer.SelectedFolder.Name, TargetNullValue=请选择分类}" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock Margin="0,3,0,0" Text="每条规则对应一个真实文件夹，可设置多个关键词" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource QuietButtonStyle}" Command="{Binding Organizer.DeleteRuleCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="Delete20" FontSize="16" />
                    <TextBlock Text="删除所选规则" />
                  </StackPanel>
                </Button>
              </Grid>
              <DataGrid Grid.Row="1" ItemsSource="{Binding Organizer.CurrentRules}" SelectedItem="{Binding Organizer.SelectedRule, Mode=TwoWay}"
                        AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="标题" Width="1.4*" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="关键词（逗号分隔）" Width="1.8*" Binding="{Binding Keywords, UpdateSourceTrigger=PropertyChanged}" />
                  <DataGridTextColumn Header="真实文件夹路径" Width="3*" Binding="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
              </DataGrid>
              <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="1.8*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <TextBox MinHeight="36" Padding="9,6" Text="{Binding Organizer.NewRuleTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="规则标题（可选）" />
                <TextBox Grid.Column="2" MinHeight="36" Padding="9,6" Text="{Binding Organizer.NewRuleKeywords, UpdateSourceTrigger=PropertyChanged}" ToolTip="关键词，逗号分隔" />
                <TextBox Grid.Column="4" MinHeight="36" Padding="9,6" Text="{Binding Organizer.NewRulePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="真实文件夹路径" />
              </Grid>
              <Grid Grid.Row="3" Margin="0,9,0,0">
                <TextBlock Text="{Binding Organizer.Message}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                  <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding Organizer.MoveSelectedRuleCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" Symbol="FolderArrowRight20" FontSize="16" />
                      <TextBlock Text="移动所选规则" />
                    </StackPanel>
                  </Button>
                  <Button Margin="8,0,0,0" Command="{Binding Organizer.AddRuleCommand}">
                    <StackPanel Orientation="Horizontal">
                      <ui:SymbolIcon Margin="0,0,6,0" Symbol="AddCircle20" FontSize="16" />
                      <TextBlock Text="新建规则" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Margin="0,14,0,0" Padding="22,14" Background="{DynamicResource MutedSurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <Grid>
        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Style="{StaticResource QuietButtonStyle}" Command="{Binding CancelCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" Symbol="Dismiss20" FontSize="16" />
              <TextBlock Text="取消" />
            </StackPanel>
          </Button>
          <Button Margin="8,0,0,0" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,6,0" Symbol="Save20" FontSize="16" />
              <TextBlock Text="保存更改" Foreground="White" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
