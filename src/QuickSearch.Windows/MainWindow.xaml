<Window x:Class="QuickSearch.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickSearch.Core;assembly=QuickSearch.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="" Icon="Assets/QuickSearch.ico" Width="1080" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <HierarchicalDataTemplate DataType="{x:Type core:NavigationFolderNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <Button Style="{StaticResource ExplorerTreeItemStyle}"
              Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding Folder}"
              PreviewMouseLeftButtonDown="Folder_PreviewMouseLeftButtonDown"
              PreviewMouseMove="Folder_PreviewMouseMove"
              AllowDrop="True"
              DragOver="Folder_DragOver"
              DragLeave="Folder_DragLeave"
              Drop="Folder_Drop"
              ToolTip="单击打开；可将快捷导航或其他文件夹拖到这里">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Margin="0,0,7,0" Symbol="FolderOpen20" FontSize="17"
                         Foreground="{DynamicResource RouteBlueBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <ui:SymbolIcon Grid.Column="2" Margin="8,0,2,0" Symbol="Star16" FontSize="14"
                         Foreground="{DynamicResource RouteBlueBrush}"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="新建子文件夹…" Click="Folder_NewChild_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="FolderAdd20" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="重命名…" Click="Folder_Rename_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Edit20" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="删除…" Click="Folder_Delete_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Delete20" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="固定到顶部" Click="Folder_Pin_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Pin20" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="取消顶部固定" Click="Folder_Unpin_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="PinOff20" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
  </Window.InputBindings>

  <Grid Background="{DynamicResource PaperBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
            Background="{DynamicResource PaperBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="44" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="138" />
        </Grid.ColumnDefinitions>
        <Border Margin="8,6" Background="{DynamicResource SoftBlueBrush}" CornerRadius="8">
          <ui:SymbolIcon Symbol="Pin20" FontSize="17" Foreground="{DynamicResource RouteBlueBrush}" />
        </Border>
        <ScrollViewer Grid.Column="1" Margin="4,5,8,5"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Explorer.PinnedFolders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,6,0" MinHeight="32" Padding="11,5"
                        Style="{StaticResource PinnedFolderButtonStyle}"
                        Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        PreviewMouseLeftButtonDown="PinnedFolder_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PinnedFolder_PreviewMouseMove"
                        AllowDrop="True"
                        DragOver="PinnedFolder_DragOver"
                        DragLeave="PinnedFolder_DragLeave"
                        Drop="PinnedFolder_Drop">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,7,0" Symbol="Pin16" FontSize="14"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Column="2" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="46" />
          </Grid.ColumnDefinitions>
          <Button Padding="0" Style="{StaticResource WindowCaptionButtonStyle}"
                  ToolTip="最小化" Click="MinimizeWindow_Click">
            <ui:SymbolIcon Symbol="Subtract20" FontSize="15" />
          </Button>
          <Button Grid.Column="1" Padding="0" Style="{StaticResource WindowCaptionButtonStyle}"
                  ToolTip="最大化" Click="MaximizeWindow_Click">
            <ui:SymbolIcon Symbol="Square20" FontSize="13" />
          </Button>
          <Button Grid.Column="2" Padding="0" Style="{StaticResource WindowCloseButtonStyle}"
                  ToolTip="隐藏" Click="CloseWindow_Click">
            <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" />
          </Button>
        </Grid>
      </Grid>
    </Border>

    <Grid x:Name="ExplorerPage" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SidebarColumn" Width="210" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="Sidebar" Grid.Column="0" Padding="14,18"
              Background="{DynamicResource MutedSurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="8,0,0,12">
            <TextBlock Text="文件夹" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Width="30" Height="28" Padding="0"
                      ToolTip="在当前文件夹中新建子文件夹"
                      AutomationProperties.Name="新建子文件夹"
                      Style="{StaticResource QuietButtonStyle}"
                      Click="Sidebar_NewFolder_Click">
                <ui:SymbolIcon Symbol="FolderAdd20" FontSize="18" />
              </Button>
              <Button Width="30" Height="28" Padding="0" Margin="2,0,0,0"
                      ToolTip="收起文件夹栏"
                      AutomationProperties.Name="收起文件夹栏"
                      Style="{StaticResource QuietButtonStyle}"
                      Click="CollapseSidebar_Click">
                <ui:SymbolIcon Symbol="PanelLeftContract20" FontSize="18" />
              </Button>
            </StackPanel>
          </Grid>
          <TreeView ItemsSource="{Binding Explorer.RootFolders}"
                    Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource ExplorerTreeViewItemStyle}" />
        </DockPanel>
      </Border>

      <Border x:Name="CollapsedSidebar" Grid.Column="0" Visibility="Collapsed"
              Background="{DynamicResource MutedSurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <Button Width="34" Height="34" Margin="7,12,7,0" Padding="0"
                VerticalAlignment="Top" ToolTip="展开文件夹栏"
                AutomationProperties.Name="展开文件夹栏"
                Style="{StaticResource QuietButtonStyle}"
                Click="ExpandSidebar_Click">
          <ui:SymbolIcon Symbol="PanelLeftExpand20" FontSize="18" />
        </Button>
      </Border>

      <Grid Grid.Column="1" Margin="20,16,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Explorer.Breadcrumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource BreadcrumbButtonStyle}"
                          Content="{Binding Name}"
                          Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <ui:SymbolIcon Margin="5,0" Symbol="ChevronRight12" FontSize="11"
                                 Foreground="{DynamicResource SlateBrush}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Column="1" Margin="24,0,0,0" MinWidth="420">
            <TextBox x:Name="SearchBox" Padding="38,9,34,9"
                     MinHeight="48" FontSize="15"
                     AutomationProperties.Name="搜索规则和文件夹"
                     Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <ui:SymbolIcon Margin="13,0,0,0" Symbol="Search20" FontSize="18"
                           Foreground="{DynamicResource SlateBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Button Width="30" Height="30" Padding="0" Margin="0,0,5,0" HorizontalAlignment="Right"
                    Style="{StaticResource QuietButtonStyle}"
                    Command="{Binding Explorer.ClearSearchCommand}">
              <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
            </Button>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,9" CornerRadius="10"
                Background="{DynamicResource SoftBlueBrush}"
                Visibility="{Binding Bootstrap.IsBootstrapPanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,4"
                    Content="{Binding Bootstrap.InstallButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding Bootstrap.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="{Binding Bootstrap.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Explorer.IsSearching}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <DockPanel Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Padding="10,5"
                    AutomationProperties.Name="在当前文件夹中新建快捷导航"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="CurrentFolder_NewRule_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,6,0" Symbol="AddCircle20" FontSize="17" />
                <TextBlock Text="新建快捷导航" />
              </StackPanel>
            </Button>
            <TextBlock Text="快捷导航" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Margin="12,1,0,0" Text="拖到左侧文件夹即可整理" Style="{StaticResource SecondaryTextStyle}" />
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
              <TextBlock Padding="16,20" Text="当前文件夹还没有快捷导航。点击右上角“新建快捷导航”，或从其他文件夹拖入。"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Explorer.CurrentRules.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Explorer.CurrentRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RuleRowButtonStyle}"
                          Command="{Binding DataContext.Explorer.OpenRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          PreviewMouseLeftButtonDown="Rule_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Rule_PreviewMouseMove"
                          ToolTip="单击打开；拖到左侧文件夹或右键可移动">
                    <Button.ContextMenu>
                      <ContextMenu Opened="RuleContextMenu_Opened">
                        <MenuItem Header="打开文件夹" Click="RuleContextOpen_Click">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="OpenFolder20" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="编辑…" Click="RuleContextEdit_Click">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Edit20" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="移动到文件夹" Tag="MoveRuleRoot">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="FolderArrowRight20" />
                          </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="删除…" Click="RuleContextDelete_Click">
                          <MenuItem.Icon>
                            <ui:SymbolIcon Symbol="Delete20" />
                          </MenuItem.Icon>
                        </MenuItem>
                      </ContextMenu>
                    </Button.ContextMenu>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <ui:SymbolIcon Margin="0,0,11,0" Symbol="ReOrderDotsVertical20" FontSize="18"
                                     Foreground="{DynamicResource SlateBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,20,0" Text="{Binding FolderPath}" Foreground="{DynamicResource SlateBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0" Text="打开" Foreground="{DynamicResource RouteBlueBrush}" />
                        <ui:SymbolIcon Symbol="OpenFolder20" FontSize="17"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding Explorer.IsSearching, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchEverythingCommand}"
                    Visibility="{Binding CanSearchEverything, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,7,0" Symbol="FolderSearch20" FontSize="17" />
                <TextBlock Text="使用 Everything 搜索文件夹" Foreground="White" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="搜索结果" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Margin="0,3,0,0" Text="优先匹配本地分类和快捷导航名称" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Explorer.SearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Button Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Folder}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource RuleRowButtonStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ExplorerSearchResultKind.Rule}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" Margin="0,0,11,0" CornerRadius="9"
                                  Background="{DynamicResource SoftBlueBrush}">
                            <ui:SymbolIcon Symbol="Folder20" FontSize="18"
                                           Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CategoryPath}"
                                       Foreground="{DynamicResource SlateBrush}" />
                          </StackPanel>
                          <Border Grid.Column="2" Margin="14,0,0,0"
                                  Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                        </Grid>
                      </Button>
                      <Button Command="{Binding DataContext.Explorer.OpenRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Rule}"
                              PreviewMouseLeftButtonDown="Rule_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Rule_PreviewMouseMove"
                              ToolTip="单击打开；拖到左侧文件夹或右键可移动">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource RuleRowButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ExplorerSearchResultKind.Rule}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Button.ContextMenu>
                          <ContextMenu Opened="RuleContextMenu_Opened">
                            <MenuItem Header="打开文件夹" Click="RuleContextOpen_Click">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="OpenFolder20" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="编辑…" Click="RuleContextEdit_Click">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Edit20" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="移动到文件夹" Tag="MoveRuleRoot">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="FolderArrowRight20" />
                              </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="删除…" Click="RuleContextDelete_Click">
                              <MenuItem.Icon>
                                <ui:SymbolIcon Symbol="Delete20" />
                              </MenuItem.Icon>
                            </MenuItem>
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" Margin="0,0,11,0" CornerRadius="9"
                                  Background="{DynamicResource SoftCyanBrush}">
                            <ui:SymbolIcon Symbol="FolderLink20" FontSize="18"
                                           Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CategoryPath}"
                                       Foreground="{DynamicResource SlateBrush}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding FolderPath}"
                                       Foreground="{DynamicResource SlateBrush}" FontSize="11" />
                          </StackPanel>
                          <Border Grid.Column="2" Margin="14,0,0,0"
                                  Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                        </Grid>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox Margin="0,8,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                       Visibility="{Binding IsEverythingSearchVisible, Converter={StaticResource BoolToVisibility}}"
                       ItemContainerStyle="{StaticResource ResultListItemStyle}">
                <ListBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                  <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenSelectedCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Margin="0,0,11,0" Symbol="FolderSearch20" FontSize="18"
                                     Foreground="{DynamicResource RouteBlueBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding FullPath}"
                                   Foreground="{DynamicResource SlateBrush}" />
                      </StackPanel>
                      <Border Grid.Column="2" Margin="14,0,0,0"
                              Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                        <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <Grid x:Name="GeneralSettingsPage" Grid.Row="1" Visibility="Collapsed"
          Background="{DynamicResource PaperBrush}"
          AutomationProperties.Name="通用设置页面">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Border Padding="28,22,28,18" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Button Width="36" Height="36" Margin="0,2,14,0" Padding="0"
                  VerticalAlignment="Top" ToolTip="返回文件夹"
                  AutomationProperties.Name="返回文件夹"
                  Style="{StaticResource QuietButtonStyle}"
                  Command="{Binding CancelCommand}">
            <ui:SymbolIcon Symbol="ArrowLeft20" FontSize="18" />
          </Button>
          <Border Grid.Column="1" Width="44" Height="44" Margin="0,0,14,0"
                  CornerRadius="12" Background="{DynamicResource SoftBlueBrush}">
            <ui:SymbolIcon Symbol="Settings24" FontSize="22"
                           Foreground="{DynamicResource RouteBlueBrush}" />
          </Border>
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="通用设置" Style="{StaticResource WindowTitleStyle}" />
            <TextBlock Margin="0,3,0,0" Text="快捷键、启动行为和应用更新"
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,22,28,26" MaxWidth="880" HorizontalAlignment="Center">
          <TextBlock Text="搜索服务" Style="{StaticResource SectionTitleStyle}" />
          <Border Margin="0,10,0,24" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="42" Height="42" Margin="0,0,14,0" CornerRadius="12"
                      Background="{DynamicResource SoftCyanBrush}">
                <ui:SymbolIcon Symbol="Database20" FontSize="20"
                               Foreground="{DynamicResource RouteBlueBrush}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Everything" FontWeight="SemiBold" />
                <TextBlock Margin="0,4,0,0" Text="{Binding EverythingHealthText}"
                           TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="快捷键" Style="{StaticResource SectionTitleStyle}" />
          <Border Margin="0,10,0,24" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="剪贴板快速打开" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Margin="0,7,0,0"
                         AutomationProperties.Name="剪贴板快速打开快捷键"
                         Text="{Binding Shortcut, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="2,6,0,0" Text="复制快捷导航名称后使用，直接打开关联的文件夹。"
                           TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="桌面快速启动器" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Margin="0,7,0,0"
                         AutomationProperties.Name="桌面快速启动器快捷键"
                         Text="{Binding LauncherShortcut, UpdateSourceTrigger=PropertyChanged}" />
                <DockPanel Margin="2,6,0,0">
                  <Button DockPanel.Dock="Right" Margin="12,-5,0,0" Padding="9,4"
                          Style="{StaticResource QuietButtonStyle}"
                          Command="{Binding OpenQuickLauncherCommand}">
                    <TextBlock Text="试一下" Foreground="{DynamicResource RouteBlueBrush}" />
                  </Button>
                  <TextBlock Text="默认 Alt+K，随时搜索快捷导航、应用和文件。"
                             TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                </DockPanel>
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Text="启动行为" Style="{StaticResource SectionTitleStyle}" />
          <Border Margin="0,10,0,24" Style="{StaticResource SurfaceCardStyle}">
            <StackPanel>
              <CheckBox Content="登录 Windows 后自动启动 QuickSearch"
                        IsChecked="{Binding StartWithWindows}" />
              <CheckBox Margin="0,14,0,0" Content="每次启动时自动检查更新"
                        IsChecked="{Binding AutomaticallyCheckForUpdates}" />
            </StackPanel>
          </Border>

          <TextBlock Text="应用更新" Style="{StaticResource SectionTitleStyle}" />
          <Border Margin="0,10,0,0" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="42" Height="42" Margin="0,0,14,0" CornerRadius="12"
                      Background="{DynamicResource SoftBlueBrush}">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="21"
                               Foreground="{DynamicResource RouteBlueBrush}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold">
                  <Run Text="当前版本 " /><Run Text="{Binding Update.InstalledVersion, Mode=OneWay}" />
                  <Run Text=" · 最新版本 " /><Run Text="{Binding Update.LatestVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,4,0,0" Text="{Binding Update.StatusText}"
                           TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
                <ProgressBar Margin="0,12,0,0" Height="4" Minimum="0" Maximum="1"
                             Value="{Binding Update.DownloadProgress, Mode=OneWay}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Margin="18,0,0,0" Orientation="Horizontal"
                          VerticalAlignment="Top">
                <Button Style="{StaticResource QuietButtonStyle}"
                        Command="{Binding Update.CheckNowCommand}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowSync20" FontSize="16" />
                    <TextBlock Text="检查更新" />
                  </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Style="{StaticResource PrimaryButtonStyle}"
                        IsEnabled="{Binding Update.CanDownloadAndInstall}"
                        Click="Settings_DownloadAndInstall_Click">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="ArrowDownload20" FontSize="16" />
                    <TextBlock Text="下载并安装" Foreground="White" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="28,14" BorderBrush="{DynamicResource LineBrush}"
              BorderThickness="0,1,0,0" Background="{DynamicResource MutedSurfaceBrush}">
        <Grid MaxWidth="880" HorizontalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Foreground="{DynamicResource SlateBrush}" />
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Padding="14,8" Style="{StaticResource QuietButtonStyle}"
                    Command="{Binding CancelCommand}">
              <TextBlock Text="取消" />
            </Button>
            <Button Margin="8,0,0,0" Padding="16,8"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,6,0" Symbol="Save20" FontSize="16" />
                <TextBlock Text="保存设置" Foreground="White" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Grid x:Name="OnboardingPage" Grid.Row="1" Visibility="Collapsed"
          Background="{DynamicResource FogBrush}"
          AutomationProperties.Name="首次使用教程">
      <Grid Margin="44,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <StackPanel>
            <TextBlock Text="欢迎使用 QuickSearch" Style="{StaticResource WindowTitleStyle}" />
            <TextBlock Margin="0,5,0,0" Text="用 4 个步骤建立自己的文件夹快速入口"
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
          <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                  Padding="12,7" Style="{StaticResource QuietButtonStyle}"
                  Command="{Binding SkipCommand}">
            <TextBlock Text="跳过教程" />
          </Button>
        </Grid>

        <Border Grid.Row="1" Width="720" MaxWidth="720" Margin="0,26,0,20"
                HorizontalAlignment="Center" VerticalAlignment="Stretch"
                Style="{StaticResource SurfaceCardStyle}" Padding="0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="6" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ProgressValue, Mode=OneWay}"
                         Height="6" BorderThickness="0" Background="{DynamicResource SoftBlueBrush}"
                         Foreground="{DynamicResource RouteBlueBrush}" />
            <Grid Grid.Row="1" Margin="46,34">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid>
                <Border Width="58" Height="58" HorizontalAlignment="Left" CornerRadius="16"
                        Background="{DynamicResource SoftBlueBrush}">
                  <ui:SymbolIcon FontSize="28" Foreground="{DynamicResource RouteBlueBrush}">
                    <ui:SymbolIcon.Style>
                      <Style TargetType="ui:SymbolIcon">
                        <Setter Property="Symbol" Value="FolderAdd24" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CurrentStepIndex}" Value="1">
                            <Setter Property="Symbol" Value="DesktopKeyboard24" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CurrentStepIndex}" Value="2">
                            <Setter Property="Symbol" Value="Search24" />
                          </DataTrigger>
                          <DataTrigger Binding="{Binding CurrentStepIndex}" Value="3">
                            <Setter Property="Symbol" Value="FolderOpen24" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </ui:SymbolIcon.Style>
                  </ui:SymbolIcon>
                </Border>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                  <TextBlock Text="{Binding CurrentStep.Label}" HorizontalAlignment="Right"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource RouteBlueBrush}" />
                  <TextBlock Margin="0,4,0,0" Text="{Binding ProgressText}" HorizontalAlignment="Right"
                             Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
              </Grid>

              <StackPanel Grid.Row="1" Margin="0,34,0,22" VerticalAlignment="Center">
                <TextBlock Text="{Binding CurrentStep.Title}" TextWrapping="Wrap"
                           FontFamily="{DynamicResource DisplayFont}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Margin="0,15,0,0" Text="{Binding CurrentStep.Description}"
                           TextWrapping="Wrap" FontSize="16" LineHeight="26"
                           Foreground="{DynamicResource SlateBrush}" />
                <Border Margin="0,22,0,0" Padding="14,11" CornerRadius="10"
                        Background="{DynamicResource SoftCyanBrush}">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,1,9,0" Symbol="ChatHelp20" FontSize="18"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                    <TextBlock Text="{Binding CurrentStep.Detail}" TextWrapping="Wrap"
                               Foreground="{DynamicResource SlateBrush}" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap"
                         Foreground="{DynamicResource ErrorBrush}" />
            </Grid>
          </Grid>
        </Border>

        <Grid Grid.Row="2" Width="720" HorizontalAlignment="Center">
          <Button Padding="15,8" HorizontalAlignment="Left"
                  Style="{StaticResource QuietButtonStyle}" Command="{Binding BackCommand}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Margin="0,0,7,0" Symbol="ChevronLeft20" FontSize="16" />
              <TextBlock Text="上一步" />
            </StackPanel>
          </Button>
          <Button Padding="18,9" HorizontalAlignment="Right" IsDefault="True"
                  Style="{StaticResource PrimaryButtonStyle}" Command="{Binding NextCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding PrimaryActionText}" Foreground="White" />
              <ui:SymbolIcon Margin="8,0,0,0" Symbol="ChevronRight20" FontSize="16"
                             Foreground="White" />
            </StackPanel>
          </Button>
        </Grid>
      </Grid>
    </Grid>

    <Border x:Name="AppBottomBar" Grid.Row="2" Padding="18,0"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0"
            Background="{DynamicResource MutedSurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Margin="0,0,7,0" Symbol="DesktopKeyboard20" FontSize="16"
                         Foreground="{DynamicResource SlateBrush}" />
          <TextBlock Text="Esc 隐藏 · Ctrl+K 页面搜索 · Alt+K 快速启动 · Ctrl+1–9 快速打开"
                     Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Margin="18,0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource SlateBrush}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Width="34" Height="34" Padding="0" Margin="0,0,4,0"
                  ToolTip="打开快速启动器" AutomationProperties.Name="打开快速启动器"
                  Style="{StaticResource BottomGearButtonStyle}" Click="QuickLauncher_Click">
            <ui:SymbolIcon Symbol="Search20" FontSize="18" />
          </Button>
          <Button Width="34" Height="34" Padding="0"
                  ToolTip="设置" AutomationProperties.Name="设置"
                  Style="{StaticResource BottomGearButtonStyle}" Command="{Binding ShowSettingsCommand}">
            <ui:SymbolIcon Symbol="Settings24" FontSize="19" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
