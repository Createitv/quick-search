<Window x:Class="QuickSearch.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickSearch" Icon="Assets/QuickSearch.ico" Width="700" Height="600"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        Closing="Window_Closing">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
  </Window.InputBindings>

  <Grid Margin="24">
    <Border Background="{DynamicResource PaperBrush}"
            CornerRadius="16"
            Padding="24">
      <Border.Effect>
        <DropShadowEffect BlurRadius="22"
                          Direction="270"
                          ShadowDepth="5"
                          Color="#27364F"
                          Opacity="0.12" />
      </Border.Effect>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="QuickSearch" Style="{StaticResource WindowTitleStyle}" />
            <TextBlock Margin="0,4,0,0"
                       Text="复制邮箱别名，确认路径后快速打开"
                       Style="{StaticResource SecondaryTextStyle}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
            <Border Style="{StaticResource PillStyle}" Margin="0,1,8,0">
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7"
                         Margin="0,0,7,0"
                         VerticalAlignment="Center"
                         Fill="{DynamicResource SignalCyanBrush}" />
                <TextBlock Text="Everything 搜索"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SlateBrush}" />
              </StackPanel>
            </Border>
            <Button Content="设置"
                    Style="{StaticResource QuietButtonStyle}"
                    Command="{Binding ShowSettingsCommand}" />
          </StackPanel>
        </Grid>

        <!-- The route beam is the product-specific alias-to-folder signature. -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="11*" />
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="14*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="邮箱别名" Style="{StaticResource FieldLabelStyle}" />
              <TextBox x:Name="AliasBox"
                       FontSize="16"
                       Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
          </Border>

          <Grid Grid.Column="1" VerticalAlignment="Center" Margin="-1,0">
            <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                  <GradientStop Color="{StaticResource RouteBlueColor}" Offset="0" />
                  <GradientStop Color="{StaticResource SignalCyanColor}" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Ellipse Width="11" Height="11"
                     HorizontalAlignment="Right"
                     Fill="{DynamicResource SignalCyanBrush}"
                     Stroke="White"
                     StrokeThickness="2" />
          </Grid>

          <Border Grid.Column="2" Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
            <StackPanel>
              <TextBlock Text="真实文件夹名称" Style="{StaticResource FieldLabelStyle}" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         FontSize="16"
                         Text="{Binding FolderQuery, UpdateSourceTrigger=PropertyChanged}">
                  <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                  </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Content="搜索"
                        Command="{Binding SearchCommand}" />
              </Grid>
              <TextBlock Margin="2,7,2,0"
                         MaxHeight="36"
                         Text="{Binding SelectedResult.FullPath, TargetNullValue=候选路径将在此显示}"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{DynamicResource SlateBrush}"
                         FontSize="11" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,0,0,16"
                Padding="13,10"
                Background="{DynamicResource SoftCyanBrush}"
                CornerRadius="10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="8" Height="8"
                     Margin="0,1,10,0"
                     VerticalAlignment="Top"
                     Fill="{DynamicResource SignalCyanBrush}" />
            <TextBlock Grid.Column="1"
                       Text="{Binding Status}"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="{DynamicResource InkBrush}" />
          </Grid>
        </Border>

        <Grid Grid.Row="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,10">
            <TextBlock Text="搜索结果" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Text="Enter 打开  ·  双击打开"
                       Style="{StaticResource SecondaryTextStyle}" />
          </Grid>
          <ListBox Grid.Row="1"
                   ItemsSource="{Binding Results}"
                   SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                   ItemContainerStyle="{StaticResource ResultListItemStyle}">
            <ListBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding ConfirmOpenCommand}" />
              <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ConfirmOpenCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,18,0"
                               Text="{Binding FullPath}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SlateBrush}"
                               FontSize="12" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <Grid Grid.Row="4" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Esc  隐藏"
                       VerticalAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}" />
            <Border Margin="12,0,0,0"
                    Padding="9,4"
                    Background="{DynamicResource MutedSurfaceBrush}"
                    CornerRadius="8">
              <TextBlock Text="{Binding ShortcutInstruction}"
                         FontSize="11"
                         Foreground="{DynamicResource SlateBrush}" />
            </Border>
          </StackPanel>
          <Button Grid.Column="1"
                  Content="打开文件夹  →"
                  IsDefault="True"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding ConfirmOpenCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
