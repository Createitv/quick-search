<Window x:Class="QuickSearch.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:QuickSearch.Core;assembly=QuickSearch.Core"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="" Icon="Assets/QuickSearch.ico" Width="1080" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <HierarchicalDataTemplate DataType="{x:Type core:NavigationFolderNodeViewModel}"
                              ItemsSource="{Binding Children}">
      <Button Style="{StaticResource ExplorerTreeItemStyle}"
              Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding Folder}"
              AllowDrop="True"
              DragOver="Folder_DragOver"
              DragLeave="Folder_DragLeave"
              Drop="Folder_Drop"
              ToolTip="单击打开；可将快捷方式拖到这里">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <ui:SymbolIcon Margin="0,0,7,0" Symbol="FolderOpen20" FontSize="17"
                         Foreground="{DynamicResource RouteBlueBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
          <ui:SymbolIcon Grid.Column="2" Margin="8,0,2,0" Symbol="Star16" FontSize="14"
                         Foreground="{DynamicResource RouteBlueBrush}"
                         Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <Button.ContextMenu>
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="新建子文件夹…" Click="Folder_NewChild_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="FolderAdd20" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="重命名…" Click="Folder_Rename_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Edit20" /></MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="固定到顶部" Click="Folder_Pin_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="Pin20" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="取消顶部固定" Click="Folder_Unpin_Click">
              <MenuItem.Icon><ui:SymbolIcon Symbol="PinOff20" /></MenuItem.Icon>
            </MenuItem>
          </ContextMenu>
        </Button.ContextMenu>
      </Button>
    </HierarchicalDataTemplate>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding HideCommand}" />
  </Window.InputBindings>

  <Grid Background="{DynamicResource PaperBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="48" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="38" Height="38" Margin="0,0,12,0" Background="{DynamicResource SoftBlueBrush}" CornerRadius="11">
          <ui:SymbolIcon Symbol="Pin24" FontSize="20" Foreground="{DynamicResource RouteBlueBrush}" />
        </Border>
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Explorer.PinnedFolders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Margin="0,0,8,0"
                        Style="{StaticResource PinnedFolderButtonStyle}"
                        Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        PreviewMouseLeftButtonDown="PinnedFolder_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="PinnedFolder_PreviewMouseMove"
                        AllowDrop="True"
                        DragOver="PinnedFolder_DragOver"
                        DragLeave="PinnedFolder_DragLeave"
                        Drop="PinnedFolder_Drop">
                  <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,7,0" Symbol="Pin16" FontSize="14"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                    <TextBlock Text="{Binding Name}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="238" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Padding="14,18" Background="{DynamicResource MutedSurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="8,0,0,12">
            <TextBlock Text="文件夹" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Width="30" Height="28" Padding="0"
                    ToolTip="在当前文件夹中新建子文件夹"
                    AutomationProperties.Name="新建子文件夹"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="Sidebar_NewFolder_Click">
              <ui:SymbolIcon Symbol="FolderAdd20" FontSize="18" />
            </Button>
          </Grid>
          <TreeView ItemsSource="{Binding Explorer.RootFolders}"
                    Background="Transparent" BorderThickness="0"
                    ItemContainerStyle="{StaticResource ExplorerTreeViewItemStyle}" />
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="24,20,24,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
          </Grid.ColumnDefinitions>
          <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Explorer.Breadcrumbs}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal">
                  <Button Style="{StaticResource BreadcrumbButtonStyle}"
                          Content="{Binding Name}"
                          Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}" />
                  <ui:SymbolIcon Margin="5,0" Symbol="ChevronRight12" FontSize="11"
                                 Foreground="{DynamicResource SlateBrush}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox" Padding="38,9,34,9"
                     AutomationProperties.Name="搜索规则和文件夹"
                     Text="{Binding Explorer.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
            <ui:SymbolIcon Margin="13,0,0,0" Symbol="Search20" FontSize="18"
                           Foreground="{DynamicResource SlateBrush}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Button Width="30" Height="30" Padding="0" Margin="0,0,5,0" HorizontalAlignment="Right"
                    Style="{StaticResource QuietButtonStyle}"
                    Command="{Binding Explorer.ClearSearchCommand}">
              <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
            </Button>
          </Grid>
        </Grid>

        <Border Grid.Row="1" Margin="0,16,0,0" Padding="12,9" CornerRadius="10"
                Background="{DynamicResource SoftBlueBrush}"
                Visibility="{Binding Bootstrap.IsBootstrapPanelVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,4"
                    Content="{Binding Bootstrap.InstallButtonText, RelativeSource={RelativeSource AncestorType=Window}}"
                    Command="{Binding Bootstrap.InstallCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Text="{Binding Bootstrap.StatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                       TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Explorer.IsSearching}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ItemsControl ItemsSource="{Binding Explorer.ChildFolders}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="210" Margin="0,0,12,12" Style="{StaticResource FolderCardButtonStyle}"
                        Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="21"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                    <TextBlock Margin="0,8,0,0" Text="{Binding Name}" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Grid.Row="1" Margin="0,4,0,10">
            <Button DockPanel.Dock="Right" Padding="10,5"
                    AutomationProperties.Name="在当前文件夹中新建快捷方式"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="CurrentFolder_NewRule_Click">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,6,0" Symbol="AddCircle20" FontSize="17" />
                <TextBlock Text="新建快捷方式" />
              </StackPanel>
            </Button>
            <TextBlock Text="快捷方式" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock Margin="12,1,0,0" Text="拖到左侧文件夹即可整理" Style="{StaticResource SecondaryTextStyle}" />
          </DockPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
              <TextBlock Padding="16,20" Text="当前文件夹还没有快捷方式。可从其他文件夹拖入，或在设置中创建。"
                         TextWrapping="Wrap">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Explorer.CurrentRules.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <ItemsControl ItemsSource="{Binding Explorer.CurrentRules}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource RuleRowButtonStyle}"
                          Command="{Binding DataContext.Explorer.OpenRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          PreviewMouseLeftButtonDown="Rule_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="Rule_PreviewMouseMove"
                          ToolTip="单击打开；拖到左侧文件夹可移动">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <ui:SymbolIcon Margin="0,0,11,0" Symbol="ReOrderDotsVertical20" FontSize="18"
                                     Foreground="{DynamicResource SlateBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,20,0" Text="{Binding FolderPath}" Foreground="{DynamicResource SlateBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0" Text="打开" Foreground="{DynamicResource RouteBlueBrush}" />
                        <ui:SymbolIcon Symbol="OpenFolder20" FontSize="17"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0" Visibility="{Binding Explorer.IsSearching, Converter={StaticResource BoolToVisibility}}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SearchEverythingCommand}"
                    Visibility="{Binding CanSearchEverything, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Margin="0,0,7,0" Symbol="FolderSearch20" FontSize="17" />
                <TextBlock Text="使用 Everything 搜索文件夹" Foreground="White" />
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="搜索结果" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Margin="0,3,0,0" Text="优先匹配本地分类、规则名称、关键词和路径" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding Explorer.SearchResults}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Button Command="{Binding DataContext.Explorer.NavigateFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Folder}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource RuleRowButtonStyle}">
                            <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ExplorerSearchResultKind.Rule}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" Margin="0,0,11,0" CornerRadius="9"
                                  Background="{DynamicResource SoftBlueBrush}">
                            <ui:SymbolIcon Symbol="Folder20" FontSize="18"
                                           Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CategoryPath}"
                                       Foreground="{DynamicResource SlateBrush}" />
                          </StackPanel>
                          <Border Grid.Column="2" Margin="14,0,0,0"
                                  Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                        </Grid>
                      </Button>
                      <Button Command="{Binding DataContext.Explorer.OpenRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding Rule}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource RuleRowButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static core:ExplorerSearchResultKind.Rule}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                          </Style>
                        </Button.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <Border Width="34" Height="34" Margin="0,0,11,0" CornerRadius="9"
                                  Background="{DynamicResource SoftCyanBrush}">
                            <ui:SymbolIcon Symbol="FolderLink20" FontSize="18"
                                           Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                          <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Margin="0,4,0,0" Text="{Binding CategoryPath}"
                                       Foreground="{DynamicResource SlateBrush}" />
                            <TextBlock Margin="0,2,0,0" Text="{Binding FolderPath}"
                                       Foreground="{DynamicResource SlateBrush}" FontSize="11" />
                          </StackPanel>
                          <Border Grid.Column="2" Margin="14,0,0,0"
                                  Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                            <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource RouteBlueBrush}" />
                          </Border>
                        </Grid>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox Margin="0,8,0,0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                       Visibility="{Binding IsEverythingSearchVisible, Converter={StaticResource BoolToVisibility}}"
                       ItemContainerStyle="{StaticResource ResultListItemStyle}">
                <ListBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding OpenSelectedCommand}" />
                  <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenSelectedCommand}" />
                </ListBox.InputBindings>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ui:SymbolIcon Margin="0,0,11,0" Symbol="FolderSearch20" FontSize="18"
                                     Foreground="{DynamicResource RouteBlueBrush}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding FullPath}"
                                   Foreground="{DynamicResource SlateBrush}" />
                      </StackPanel>
                      <Border Grid.Column="2" Margin="14,0,0,0"
                              Tag="{Binding ShortcutText}" Style="{StaticResource ShortcutBadgeStyle}">
                        <TextBlock Text="{Binding ShortcutText}" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource RouteBlueBrush}" />
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Padding="18,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource MutedSurfaceBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ui:SymbolIcon Margin="0,0,7,0" Symbol="Keyboard20" FontSize="16"
                         Foreground="{DynamicResource SlateBrush}" />
          <TextBlock Text="Esc 隐藏 · Ctrl+K 搜索 · Ctrl+1–9 快速打开"
                     Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1" Margin="18,0" Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource SlateBrush}" />
        <Button Grid.Column="2" Width="34" Height="34" Padding="0"
                ToolTip="设置" AutomationProperties.Name="设置"
                Style="{StaticResource BottomGearButtonStyle}" Command="{Binding ShowSettingsCommand}">
          <ui:SymbolIcon Symbol="Settings24" FontSize="19" />
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
