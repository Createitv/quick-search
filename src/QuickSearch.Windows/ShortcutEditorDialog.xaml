<Window x:Class="QuickSearch.Windows.ShortcutEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="新建快捷方式" Icon="Assets/QuickSearch.ico"
        Width="620" SizeToContent="Height" MinHeight="430"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
  <Grid Margin="28,26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal">
      <Border Width="46" Height="46" Margin="0,0,14,0" CornerRadius="13"
              Background="{DynamicResource SoftBlueBrush}">
        <ui:SymbolIcon Symbol="FolderLink24" FontSize="22"
                       Foreground="{DynamicResource RouteBlueBrush}" />
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="新建快捷方式" Style="{StaticResource WindowTitleStyle}" FontSize="22" />
        <TextBlock Margin="0,3,0,0" Text="保存后可搜索、拖拽整理或通过右键移动"
                   Style="{StaticResource SecondaryTextStyle}" />
      </StackPanel>
    </StackPanel>

    <Border Grid.Row="1" Margin="0,20,0,20" Padding="12,9" CornerRadius="9"
            Background="{DynamicResource SoftCyanBrush}">
      <StackPanel Orientation="Horizontal">
        <ui:SymbolIcon Margin="0,0,8,0" Symbol="FolderArrowRight20" FontSize="18"
                       Foreground="{DynamicResource RouteBlueBrush}" />
        <TextBlock Text="保存到" Foreground="{DynamicResource SlateBrush}" />
        <TextBlock Margin="7,0,0,0" Text="{Binding TargetFolderPath, RelativeSource={RelativeSource AncestorType=Window}}"
                   FontWeight="SemiBold" />
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="2">
      <TextBlock Text="名称（可选）" Style="{StaticResource FieldLabelStyle}" />
      <TextBox x:Name="TitleBox" MaxLength="120" TextChanged="Field_TextChanged"
               ToolTip="留空时使用真实文件夹名称" />
      <TextBlock Margin="2,5,0,0" Text="留空时自动显示真实文件夹的名称。"
                 Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,18,0,0">
      <TextBlock Text="搜索关键词" Style="{StaticResource FieldLabelStyle}" />
      <TextBox x:Name="KeywordsBox" MaxLength="500" TextChanged="Field_TextChanged"
               ToolTip="多个关键词使用逗号分隔" />
      <TextBlock Margin="2,5,0,0" Text="至少填写一个；多个关键词用逗号分隔，例如：客户, 合同, ATR。"
                 Style="{StaticResource SecondaryTextStyle}" FontSize="12" />
    </StackPanel>

    <StackPanel Grid.Row="4" Margin="0,18,0,0">
      <TextBlock Text="真实文件夹" Style="{StaticResource FieldLabelStyle}" />
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" TextChanged="Field_TextChanged" />
        <Button Grid.Column="1" Margin="9,0,0,0" Padding="13,8"
                Style="{StaticResource QuietButtonStyle}" Click="BrowseFolder_Click">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,7,0" Symbol="FolderOpen20" FontSize="17" />
            <TextBlock Text="选择文件夹…" />
          </StackPanel>
        </Button>
      </Grid>
    </StackPanel>

    <Grid Grid.Row="5" Margin="0,24,0,0">
      <TextBlock x:Name="ValidationText" MaxWidth="330" TextWrapping="Wrap"
                 Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center" />
      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
        <Button IsCancel="True" Style="{StaticResource QuietButtonStyle}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Dismiss20" FontSize="16" />
            <TextBlock Text="取消" />
          </StackPanel>
        </Button>
        <Button x:Name="ConfirmButton" Margin="8,0,0,0" IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmButton_Click">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Margin="0,0,6,0" Symbol="AddCircle20" FontSize="16" />
            <TextBlock Text="创建快捷方式" Foreground="White" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
